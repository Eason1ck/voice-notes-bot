# Скопируйте этот файл в .env и впишите токен. Файл .env не публикуйте и не коммитьте.
BOT_TOKEN= secret

# Модель Whisper: tiny, base, small, medium, large-v3 (чем крупнее, тем точнее и медленнее)
WHISPER_MODEL=small
# cpu или cuda (если есть видеокарта NVIDIA)
WHISPER_DEVICE=cpu
# для cpu: int8, для cuda: float16
WHISPER_COMPUTE_TYPE=int8

# Лимиты
MAX_DURATION_SEC=180
MAX_FILE_MB=20
PROCESS_TIMEOUT_SEC=180
MAX_CONCURRENT_JOBS=1

# Если ffmpeg не находится через PATH, укажите полный путь к ffmpeg.exe (без кавычек), например:
FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Необязательно
# NORMALIZE_AUDIO=false
# LOG_LEVEL=INFO
